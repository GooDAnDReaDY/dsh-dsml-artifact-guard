{
  "name": "@goodandready/dsh-dsml-artifact-guard",
  "version": "0.2.17",
  "description": "Sanitizes leaked DeepSeek DSML closing tags and reasoning artifacts from model text streams",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GooDAnDReaDY/dsh-dsml-artifact-guard.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-dsml-artifact-guard#readme",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-dsml-artifact-guard/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "dsml",
    "reasoning",
    "sanitizer"
  ],
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js lib/client.js lib/telemetry.js lib/updater.js lib/request-trust.js",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
